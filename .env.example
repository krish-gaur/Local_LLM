# Jean Grey reads JEAN_GREY_* directly. LOCALPILOT_* remains a compatibility fallback.
JEAN_GREY_BACKEND=ollama
JEAN_GREY_MODEL=qwen2.5:1.5b
JEAN_GREY_OLLAMA_URL=http://127.0.0.1:11434
JEAN_GREY_CONTEXT_WINDOW=2048
JEAN_GREY_REQUEST_TIMEOUT=120
JEAN_GREY_OFFLINE=true
# Optional overrides (leave undefined for ~/.jean-grey):
# JEAN_GREY_DATA_DIR=C:\\Users\\YourName\\.jean-grey
# Local faster-whisper size/path; Jean Grey never downloads it automatically.
JEAN_GREY_STT_MODEL_SIZE=small
# JEAN_GREY_STT_MODEL_PATH=C:\\Users\\YourName\\.jean-grey\\models\\whisper-small
# JEAN_GREY_PIPER_EXECUTABLE=C:\\Tools\\piper\\piper.exe
# JEAN_GREY_PIPER_VOICE_PATH=C:\\Users\\YourName\\.jean-grey\\models\\piper\\voice.onnx
JEAN_GREY_VOICE_RATE=1.0
JEAN_GREY_HANDS_FREE=false
# MCP/browser settings (configuration contains allowlists, never secret values):
# JEAN_GREY_MCP_CONFIG=C:\\Users\\YourName\\.jean-grey\\mcp.json
# JEAN_GREY_REPORT_ROOT=C:\\Users\\YourName\\.jean-grey\\reports
JEAN_GREY_BROWSER_MAX_PAGES=10
JEAN_GREY_BROWSER_MAX_ACTIONS=30
JEAN_GREY_BROWSER_MAX_CONTENT_CHARS=100000
# Optional local hands-free components; never downloaded automatically:
# JEAN_GREY_WAKE_WORD_MODEL_PATH=C:\\Users\\YourName\\.jean-grey\\models\\wake\\hello-jean-grey.onnx
JEAN_GREY_WAKE_WORD_THRESHOLD=0.65
JEAN_GREY_VOICE_LANGUAGE=auto
# Must have matching .onnx.json metadata with language.code beginning with hi:
# JEAN_GREY_HINDI_PIPER_VOICE_PATH=C:\\Users\\YourName\\.jean-grey\\models\\piper\\hi_voice.onnx
JEAN_GREY_SEARCH_BASE_URL=https://www.google.com/search?q=
